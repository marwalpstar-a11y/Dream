# ==============================================================================
# DREAMEXCH24 - Hostinger Web Server Configuration (.htaccess)
# ==============================================================================

# 1. Directory Index
DirectoryIndex index.html index.php

# 2. Security Options
Options -Indexes -MultiViews
ServerSignature Off

# 3. Canonical 301 Redirects & Clean URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # A. Redirect explicit /index.html and /index.php to root / (Canonical Home)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(html?|php)[\s?] [NC]
  RewriteRule ^index\.(html?|php)$ https://dreamexchwork.live/ [L,R=301]

  # B. Redirect explicit /blog.html to clean URL /blog (Canonical Blog)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /blog\.html[\s?] [NC]
  RewriteRule ^blog\.html$ https://dreamexchwork.live/blog [L,R=301,QSA]

  # C. Force Non-WWW (Redirect all www.dreamexchwork.live to https://dreamexchwork.live)
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://dreamexchwork.live/$1 [L,R=301]

  # D. Force HTTPS Protocol
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://dreamexchwork.live/$1 [L,R=301]

  # E. Remove trailing slashes for non-directories
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]

  # F. Clean URLs (Allow accessing /blog or /about without .html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]

  # G. Auto-serve WebP if supported by client browser and .webp file exists on disk
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,E=accept:1,L]
</IfModule>

# 4. MIME Types & UTF-8 Character Encoding
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .json .xml
  AddType "text/html; charset=UTF-8" .html
  AddType "text/css; charset=UTF-8" .css
  AddType "application/javascript; charset=UTF-8" .js
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/x-icon .ico
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# 5. Gzip & Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/x-javascript text/javascript application/json image/svg+xml image/x-icon font/woff font/woff2 application/vnd.ms-fontobject
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/javascript application/x-javascript text/javascript application/json image/svg+xml image/x-icon font/woff font/woff2 application/vnd.ms-fontobject
</IfModule>

# 6. Cache Control & Fresh Asset Delivery
<IfModule mod_headers.c>
  # Vary header for WebP CDN caching
  Header append Vary Accept env=REDIRECT_accept

  # HTML and XML sitemaps are never cached - always check server for freshest layout & deployment
  <FilesMatch "\.(html|htm|php|xml|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # CSS and JS asset caching with revalidation
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>

  # Static images, icons, and web fonts: 1 year immutable browser caching
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
