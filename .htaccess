# ==============================================================================
# DREAMEXCH24 - Hostinger Web Server Configuration (.htaccess)
# ==============================================================================

# 1. Directory Index
DirectoryIndex index.html index.php

# 2. Security Options
Options -Indexes
ServerSignature Off

# 3. Canonical 301 Redirects & Clean URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # A. Redirect explicit /index.html and /index.php to root / (Canonical Home)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(html?|php)[\s?] [NC]
  RewriteRule ^index\.(html?|php)$ https://dreamexchwork.live/ [L,R=301]

  # B. Force Non-WWW (Redirect all www.dreamexchwork.live to https://dreamexchwork.live)
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://dreamexchwork.live/$1 [L,R=301]

  # C. Force HTTPS Protocol
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://dreamexchwork.live/$1 [L,R=301]

  # D. Remove trailing slashes for non-directories
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]

  # E. Clean URLs (Allow accessing /about instead of /about.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

# 4. MIME Types & UTF-8 Character Encoding
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .json .xml
  AddType "text/html; charset=UTF-8" .html
  AddType "text/css; charset=UTF-8" .css
  AddType "application/javascript; charset=UTF-8" .js
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# 5. Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 6. Cache Control & Fresh Asset Delivery
<IfModule mod_headers.c>
  # HTML and XML sitemaps are never cached - always check server for freshest layout & deployment
  <FilesMatch "\.(html|htm|php|xml|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # CSS and JS have revalidation so new versions are fetched immediately upon deploy
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
